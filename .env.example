#DATABASE_URL=postgresql+psycopg://trackers:trackers@postgres:5432/trackers
# Supabase pooler example. URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://trackers:trackers@postgres:5432/trackers
CORS_ORIGINS=http://localhost:5173
# Use a long random value in production. Keep this backend-only.
JWT_SECRET=replace-me-with-a-long-random-secret
VITE_API_BASE_URL=http://localhost:8000/api/v1
